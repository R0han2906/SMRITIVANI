APP_NAME=SmritiVani API
APP_ENV=local
HOST=127.0.0.1
PORT=8020
API_PREFIX=/api
RELOAD=false

# Direct PostgreSQL connection (copy the URI from Supabase Dashboard > Connect).
# Keep sslmode=require in DATABASE_URL. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Needed for Supabase Auth signup/login and the RLS-backed Data API requests.
SUPABASE_URL=https://kpdehaqgltaaqphewrph.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_rdV4E5GOHXa8fceZ2FpwJg_XFtkaF-G


# Supabase Auth issues and verifies the access/refresh JWTs. Do not add a
# SUPABASE_JWT_SECRET: the API validates bearer tokens with Supabase Auth and
# passes the user token through to RLS-protected database functions.

# Gnani Speech-to-Text API key (used for recorded microphone audio)
# Get it from: https://console.gnani.ai/api-keys
GNANI_API_KEY=your_gnani_api_key_here
GNANI_DEFAULT_LANGUAGE=hi-IN
GNANI_STT_MODEL=prisma-v2.5

# Required for secure hashing of short numeric pairing codes. Generate a
# unique random value (at least 32 characters) for each environment.
DEVICE_PAIRING_PEPPER=generate_a_unique_random_value_at_least_32_characters

# Voice providers. `groq` uses Groq for non-emergency reply text and Gnani for
# recorded-audio transcription and spoken output. `hybrid` tries Gemini then Groq.
AI_MODE=groq
ENABLE_BROWSER_FALLBACK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GNANI_TTS_MODEL=timbre-v2.5
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
STORE_RAW_AUDIO=false
EMERGENCY_WEBHOOK_URL=
LOG_LEVEL=INFO
