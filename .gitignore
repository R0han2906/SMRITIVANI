# Secrets and local environment files. Keep safe templates such as .env.example.
.env
.env.*
*.env
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
.envrc
.secrets/
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.credentials
credentials.json
secrets.json

# Local cloud / deployment credentials and state
.vercel/
.netlify/
.wrangler/
.serverless/

# Local-only documentation or generated setup notes that may include credentials
docs/API_KEYS_*.md
!docs/API_KEYS_REQUIRED.md
SYSTEM_READY.md

# Python virtual environments, bytecode, and tooling caches
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
pip-wheel-metadata/
*.egg-info/

# Serena local indexes and session state
.serena/

# Node dependencies, build output, and framework caches
node_modules/
dist/
build/
.vite/
.cache/
.next/
.turbo/
*.tsbuildinfo

# Logs, process state, and temporary files
*.log
logs/
*.pid
*.sock
*-debug.log*
.tmp-*

# Local databases, dumps, and backups
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# User-generated local uploads; keep public/static application assets tracked
uploads/
user_uploads/

# Operating system and editor state
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.fleet/
.history/
